# 복사해서 .env 로 쓰세요. .env 는 저장소에 올리지 않아요.

# 백엔드 주소 — 개발 중엔 비워 두고 아래 프록시를 써요
VITE_API_BASE_URL=

# 개발 서버(npm run dev)가 /api 요청을 넘길 서버 주소 [임시]. 비우면 프록시를 켜지 않아요
# 예: API_PROXY_TARGET=https://2026-line1.leehyowon14.dev
API_PROXY_TARGET=

# true   = 전부 가짜 API(MSW). 기본값, 제출·시연용
# hybrid = 서버에 있는 경로(src/mocks/hybrid.js)만 서버로, 나머지는 MSW. API_PROXY_TARGET 필요
# false  = 전부 서버. API_PROXY_TARGET 필요
VITE_USE_MOCK=true
